# Copy to .env and adjust.

# Port the web UI is published on
WEB_PORT=3000

# Run the backend as this user/group (run `id -u` / `id -g`)
PUID=1000
PGID=1000

# Where files live on the host
DOWNLOADS_PATH=./downloads
CONFIG_PATH=./config

# Protect the UI with HTTP Basic auth (recommended if not localhost-only)
APP_USER=admin
APP_PASSWORD=

# Optional: seed the ARL token (otherwise enter it in Settings)
DEEZLOAD_ARL=
